<Project>
  <Import Project="$(MSBuildThisFileDirectory)Jellyfin.Target.props" Condition="'$(JellyfinVersion)' == ''" />
  <!-- One SDK target and SQLitePCL family in combined test hosts. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'AccountHub' Or '$(MSBuildProjectName)' == 'Jellyfin.Plugin.Notifications' Or '$(MSBuildProjectName)' == 'Jellyfin.Plugin.DiscordBridge' Or '$(MSBuildProjectName)' == 'Jellyfin.Plugin.PrivateSyncPlay' Or '$(MSBuildProjectName)' == 'Jellyfin.Plugin.DeletionQueue'">
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)shared/Web/admin-ui.js" LogicalName="Suite.Web.admin-ui.js" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="Jellyfin.Controller;Jellyfin.Model;Jellyfin.Common" Version="$(JellyfinVersion)" />
    <PackageReference Update="Microsoft.Data.Sqlite;Microsoft.Data.Sqlite.Core;Microsoft.EntityFrameworkCore.Sqlite;Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageReference Update="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>
</Project>
