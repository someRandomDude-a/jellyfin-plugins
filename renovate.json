{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["nuget", "npm", "github-actions", "dockerfile", "docker-compose", "custom.regex"],
  "ignorePaths": ["**/node_modules/**", "**/bin/**", "**/obj/**", "**/artifacts/**", "**/dist/**"],
  "ignoreUnstable": true,
  "dependencyDashboard": false,
  "prConcurrentLimit": 1,
  "prHourlyLimit": 0,
  "rangeStrategy": "bump",
  "automerge": false,
  "rebaseWhen": "behind-base-branch",
  "commitMessagePrefix": "chore(deps):",
  "commitBody": "{{#each upgrades}}- {{{depName}}}: {{{currentValue}}} -> {{{newValue}}}\n{{/each}}\nDependency-Maintenance: true",
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "groupName": "all project dependencies",
      "groupSlug": "all-project-dependencies"
    },
    {
      "matchFileNames": ["Jellyfin.Target.props"],
      "enabled": false,
      "description": "Historical IDE baseline; actual Jellyfin/EF/SQLite test and package targets are resolved automatically per run."
    },
    {
      "matchPackageNames": ["Jellyfin.Controller", "Jellyfin.Model", "Jellyfin.Common", "Microsoft.Data.Sqlite", "Microsoft.Data.Sqlite.Core", "Microsoft.EntityFrameworkCore.Sqlite", "Microsoft.EntityFrameworkCore.Design", "SkiaSharp", "SkiaSharp.NativeAssets.Linux.NoDependencies"],
      "enabled": false,
      "description": "Host-provided SDK/native packages follow the current reviewed Jellyfin source manifest, not independent incompatible runtime upgrades."
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["**/*.test.*"],
      "enabled": false
    },
    {
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["scripts/latest-releases.mjs"],
      "enabled": false,
      "description": "Software under test is dynamically resolved, not permanently pinned by maintenance."
    },
    {
      "matchDatasources": ["docker"],
      "pinDigests": true
    }
  ],
  "lockFileMaintenance": {
    "enabled": false,
    "schedule": ["at any time"],
    "groupName": "all project dependencies"
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/upstream-dependencies\\.json$/"],
      "matchStrings": ["\"repository\"\\s*:\\s*\"(?<depName>[^\"]+)\"\\s*,\\s*\"version\"\\s*:\\s*\"(?<currentValue>[0-9.]+)\""],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "nuget",
      "extractVersionTemplate": "^v?(?<version>[0-9.]+)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.(?:mjs|cjs|ps1|sh|ya?ml)$/"],
      "matchStrings": ["(?<depName>(?:[a-z0-9.-]+/)?[a-z0-9._-]+/[a-z0-9._-]+):(?<currentValue>v?\\d+[a-zA-Z0-9_.-]*)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?", "(?<depName>python|nginx|node):(?<currentValue>\\d+[a-zA-Z0-9_.-]*|alpine)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.sh$/"],
      "matchStrings": ["(?<depName>playwright)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "npm"
    }
  ]
}
