<Project>
  <Import Project="$(MSBuildThisFileDirectory)../../Jellyfin.Target.props" />
  <PropertyGroup>
    <Version>1.0.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;CA1002;CA1054;CA1062;CA1305;CA1307;CA1819;CA1848;CA2007;CA2254</NoWarn>
    <RepositoryUrl>https://github.com/someRandomDude-a/jellyfin-user-manager</RepositoryUrl>
  </PropertyGroup>
</Project>
