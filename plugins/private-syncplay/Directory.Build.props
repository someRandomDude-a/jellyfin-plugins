<Project>
  <Import Project="$(MSBuildThisFileDirectory)../../Jellyfin.Target.props" />
  <!-- Test/package bootstrap automatically imports the latest stable target. -->
  <PropertyGroup>
    <JellyfinTargetAbi>$(JellyfinVersion).0</JellyfinTargetAbi>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="JellyfinTargetAbi" Value="$(JellyfinTargetAbi)" />
  </ItemGroup>
</Project>
